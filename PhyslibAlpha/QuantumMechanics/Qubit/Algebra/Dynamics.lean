module

public import PhyslibAlpha.QuantumMechanics.Qubit.Algebra.Observable
public import PhyslibAlpha.ProbabilisticTheory.CStarAlgebra.Automorphism
public import Mathlib.Algebra.Star.UnitaryStarAlgAut
public import Mathlib.Analysis.CStarAlgebra.Exponential

/-!
# Abstract Hamiltonian qubit dynamics

A Hamiltonian observable generates unitary evolution and an inner automorphism flow.

## i. Overview

The construction works in any complex C⋆-algebra. It uses Mathlib's unitary exponential
and Alpha's existing `AutomorphismGroup`. The convention is `U(t) = exp(-itH)` with
`ℏ = 1`. Evolution acts by `a ↦ U(t) a U(t)⋆`. No matrix representation is chosen.

## ii. Key results

`Qubit.unitaryEvolution`, `unitaryEvolution_add` and `hamiltonianFlow`.

## iii. Table of contents

- A. Hamiltonian automorphisms

## iv. References

The imported modules provide the underlying algebraic results.

-/

@[expose] public section

/-! ## A. Hamiltonian automorphisms -/

open ProbabilisticTheory

namespace Qubit

variable {A : Type*} [CStarAlgebra A]

/-- The unitary evolution `exp(-itH)` of an abstract Hamiltonian observable, with `ℏ = 1`. -/
noncomputable def unitaryEvolution (H : Observable A) (t : ℝ) : unitary A :=
  selfAdjoint.expUnitary ((-t) • H)

/-- The Hamiltonian evolution starts at the identity. -/
@[simp]
lemma unitaryEvolution_zero (H : Observable A) : unitaryEvolution H 0 = 1 := by
  rw [unitaryEvolution, neg_zero, zero_smul, selfAdjoint.expUnitary_zero]

/-- Hamiltonian unitary evolution satisfies the additive time law. -/
lemma unitaryEvolution_add (H : Observable A) (s t : ℝ) :
    unitaryEvolution H (s + t) = unitaryEvolution H s * unitaryEvolution H t := by
  rw [unitaryEvolution, unitaryEvolution, unitaryEvolution, neg_add, add_smul]
  exact Commute.expUnitary_add
    (((Commute.refl (H : A)).smul_left (-s)).smul_right (-t))

/-- The reversible automorphism flow `a ↦ U(t) a U(t)⋆` generated by a Hamiltonian. -/
noncomputable def hamiltonianFlow (H : Observable A) : AutomorphismGroup A where
  toFun t := Unitary.conjStarAlgAut ℂ A (unitaryEvolution H t)
  map_zero_apply a := by simp
  map_add_apply s t a := by
    rw [unitaryEvolution_add, Unitary.conjStarAlgAut_mul_apply]

end Qubit
